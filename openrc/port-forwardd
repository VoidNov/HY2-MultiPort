#!/sbin/openrc-run

name="port-forwardd"
description="Native nftables port-forward daemon"

command="/usr/local/sbin/port-forwardd"
command_args="--config /etc/port-forward/config.toml --socket /run/port-forwardd.sock --state /var/lib/port-forward/state.json"
command_user="root:root"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0

depend() {
	need net
	after nftables
}

start_pre() {
	# A missing/invalid configuration is actionable and must not be respawned.
	umask 0077
	if [ ! -s /etc/port-forward/config.toml ]; then
		eerror "missing /etc/port-forward/config.toml; run: sudo port-forward init"
		return 1
	fi
	/usr/local/bin/port-forward validate --config /etc/port-forward/config.toml || return 1
}
